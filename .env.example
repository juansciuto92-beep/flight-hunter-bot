# ==========================================================
# CONFIGURACIÓN DE CORREO (GMAIL CON CONTRASEÑA DE APLICACIÓN)
# ==========================================================
# 1. Entrá a https://myaccount.google.com/apppasswords
# 2. Creá una contraseña de aplicación llamada "Bot Vuelos"
# 3. Copiá los 16 caracteres acá abajo (sin espacios)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
ALERT_RECIPIENT=tu_correo@gmail.com

# ==========================================================
# PARÁMETROS DEL BOT
# ==========================================================
MAX_PRICE_PER_LEG_USD=450
MAX_PRICE_ROUNDTRIP_USD=900
CHECK_INTERVAL_MINUTES=60
HEADLESS=true

# Tipo de cambio ARS -> USD de respaldo (por si algún sitio .com.ar devuelve ARS)
FALLBACK_USD_ARS_RATE=1250
